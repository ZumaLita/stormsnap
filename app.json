{
  "expo": {
    "name": "StormSnap",
    "slug": "stormsnap",
    "scheme": "stormsnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "be.ictstorm.stormsnap"
    },
    "android": {
      "package": "be.ictstorm.stormsnap",
      "adaptiveIcon": {
        "backgroundColor": "#1E7A55",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "StormSnap",
      "backgroundColor": "#101A15",
      "themeColor": "#1E7A55",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "StormSnap uses your camera to take your hourly snap.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E7A55"
        }
      ]
    ]
  }
}
